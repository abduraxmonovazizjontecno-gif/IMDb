# Ishqorli muhit uchun nusxa: cp .env.example .env (yoki copy .env.example .env)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=False
# Prod da: postgres://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=

# Email (parol tiklash uchun; dev da konsolga chiqadi)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=CINEMA <noreply@cinema.local>

# Telegram film import (python manage.py tg) — bot takni: BotFather -> /token
TELEGRAM_BOT_TOKEN=

# Media fayllarni Cloudflare R2 / AWS S3 da saqlash (POSTERLAR YO'QOLMASLIGI UCHUN)
# R2: r2.cloudflarestorage.com endpoint + tashqi havola (pub-...r2.dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_STORAGE_BUCKET_NAME=
MEDIA_URL=media/

# Analitika / kuzatuv (ixtiyoriy)
GOOGLE_TAG_ID=
SENTRY_DSN=